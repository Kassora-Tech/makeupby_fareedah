# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# third-party moodboard references — inspiration only, not licensed for use or redistribution
/Design Inspo/

# PNG masters for the photography. The site ships the optimised .jpg beside each
# one (21 MB of PNG -> 1.4 MB of JPEG). Masters stay local so they aren't lost;
# safe to delete once backed up elsewhere. Re-run the sharp conversion if you add
# a new master. Image Optimization is off (see next.config.ts), so the committed
# files are what browsers actually download — keep shipping .jpg, not .png.
/public/images/*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
